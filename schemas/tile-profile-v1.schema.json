{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://magnamath.app/schema/tile-profile/v1",
  "title": "MagnaMath Physical Tile Profile v1",
  "description": "A calibrated polygonal construction-piece profile for dimension- and angle-aware matching.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "id", "label", "systemId", "family", "sideRatios", "anglesDegrees", "confidence"],
  "properties": {
    "schema": { "const": "https://magnamath.app/schema/tile-profile/v1" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "label": { "type": "string", "minLength": 1 },
    "systemId": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "sideRatios": { "type": "array", "minItems": 3, "items": { "type": "number", "exclusiveMinimum": 0 } },
    "anglesDegrees": { "type": "array", "minItems": 3, "items": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 180 } },
    "dimensionsMm": { "type": "array", "items": { "type": "number", "exclusiveMinimum": 0 } },
    "thicknessMm": { "type": "number", "exclusiveMinimum": 0 },
    "cornerRadiusMm": { "type": "number", "minimum": 0 },
    "connectorType": { "type": "string" },
    "confidence": {
      "enum": ["canonical", "manufacturer-scale", "measured", "calibrated", "approximate", "unknown"]
    },
    "source": { "type": "string" },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "sampleCount", "measuredAt"],
      "properties": {
        "device": { "type": "string" },
        "method": { "enum": ["manual", "photo", "scan"] },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "measuredAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "sideRatios": { "minItems": 3 } } },
      "then": { "properties": { "anglesDegrees": { "minItems": 3 } } }
    }
  ]
}
